# Copy this file to .env and fill in real values.

NEON Postgres connection string (console.neon.tech -> Project -> Connection string):
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

JWT secret (generate: python -c "import secrets; print(secrets.token_urlsafe(64))"):
ORGAFLOW_JWT_SECRET=your-random-secret

Optional (defaults to in-app Google client id):
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
